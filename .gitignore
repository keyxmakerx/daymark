# Gradle
.gradle/
build/
**/build/
!gradle/wrapper/gradle-wrapper.jar

# Android Studio / IntelliJ
*.iml
.idea/
captures/
.externalNativeBuild/
.cxx/

# Local config
local.properties
keystore.properties
*.keystore
*.jks
# The ONE keystore that belongs in the repo: the CI debug-channel key. The rule above exists so a
# real release key can never land here by accident; this exception is deliberate and documented at
# its signingConfig in app/build.gradle.kts — the key is update-continuity for testers, not identity.
!app/ci-signing/ci-debug.keystore

# Node. The web portal has its own ignore file, but a tool run from the repo root instead of from
# companion/web creates these here, where nothing was ignoring them — that is how a vitest cache
# very nearly landed in a commit.
node_modules/
.vite/

# OS
.DS_Store

# Logs
*.log

# Companion deployment secrets and local env (never committed).
companion/.env
companion/secrets/

# Isolated git worktrees the harness creates for parallel agents. Each is a full
# checkout of this repository living inside it; committing one would nest the repo
# in itself. They are temporary and agent-owned — ignore them, never track them.
.claude/worktrees/

# Vite writes a temporary ESM copy of its config next to it while loading, named
# vite.config.ts.timestamp-<epoch>-<hex>.mjs, and deletes it when the process ends.
# A run that overlaps a `git add -A` gets one committed and then immediately shows
# as deleted — which is exactly how one reached a commit on 2026-09-12. Build
# scratch, never source.
companion/web/vite.config.ts.timestamp-*.mjs

# Kotlin compiler session data written beside the Companion server build
companion/server/.kotlin/
